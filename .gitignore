# Build products and sources fetched by tools/build.sh -- all reproducible.
/tools/root/
/tools/src/

# Python environment (ciel and friends); recreate with pip.
/venv/

# The instructor's distribution repo -- a clone with its own history.
/wityam-aicoss/
/training/

# Course handouts and media -- not ours to redistribute, and too large for git.
*.pdf
*.mp4

# designs/ is personal work space -- nothing in it is committed.  The .gitkeep
# keeps the directory itself, since bin/xschem.sh and bin/magic.sh start there.
/designs/*
!/designs/.gitkeep

# Simulation scratch
*.raw
*.out
xschem.log
